{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://github.com/josfire18/ballot-buddy/schema/source.schema.json",
 "title": "Official source",
 "description": "official/<unit>/source.json: written by the importer.",
 "type": "object",
 "required": [
  "id",
  "title",
  "url",
  "format",
  "sha256",
  "retrieved"
 ],
 "additionalProperties": false,
 "properties": {
  "id": {
   "type": "string"
  },
  "title": {
   "type": "string"
  },
  "url": {
   "type": "string",
   "pattern": "^https?://"
  },
  "format": {
   "type": "string"
  },
  "sha256": {
   "type": [
    "string",
    "null"
   ]
  },
  "retrieved": {
   "type": "string"
  },
  "archived": {
   "type": [
    "string",
    "null"
   ]
  }
 }
}

{
  "name": "ballot-buddy",
  "private": true,
  "type": "module",
  "description": "Open-source voter guide. The site is static; Node runs the data importers (tools/import) and the build (tools/build).",
  "scripts": {
    "import": "node tools/import/run.mjs",
    "build": "node --disable-warning=ExperimentalWarning tools/build/build.mjs",
    "check": "node tools/build/build.mjs --check"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "pdfjs-dist": "4.10.38"
  }
}
